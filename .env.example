# Copy to .env (never commit .env)
SESSION_SECRET=change-me-to-a-long-random-string
DEMO_PASSWORD=demo
# Kate's AI mode: a model via OpenRouter that answers with tools (proposals only; numbers validated).
# off | openrouter. Runs only for customers who allowed "Kate may use an AI model" in their profile.
KATE_LLM=off
OPENROUTER_API_KEY=
KATE_MODEL=anthropic/claude-sonnet-5.5
# Sent to OpenRouter as HTTP-Referer (app attribution)
KATE_APP_URL=http://localhost:5173
# Ecosystem engine. Partner webhooks are HMAC-SHA256 signed. One shared dev key derives a key per partner;
# in production every partner gets its own PARTNER_WEBHOOK_SECRET_<ID> (e.g. PARTNER_WEBHOOK_SECRET_SETLE).
PARTNER_WEBHOOK_MASTER=change-me-to-a-long-random-string
# Seconds before a simulated partner answers (0 = immediately, used by the tests)
PARTNER_SIM_DELAY=4
# Host header allow-list (TrustedHostMiddleware). Add your LAN IP or deployed hostname to demo from another device.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
