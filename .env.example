# Copy to .env (never commit .env)
SESSION_SECRET=change-me-to-a-long-random-string
DEMO_PASSWORD=demo
GEMINI_MODEL=gemini-2.5-flash
GCP_PROJECT=
GCP_LOCATION=europe-west1
# Kate's optional LLM layer (rewrites reply text only; numbers validated). off | gemini. Needs: pip install google-genai
KATE_LLM=off
# Either an AI Studio key, or leave empty to use Vertex AI with GCP_PROJECT + application default credentials
GEMINI_API_KEY=
# Ecosystem engine. Partner webhooks are HMAC-SHA256 signed. One shared dev key derives a key per partner;
# in production every partner gets its own PARTNER_WEBHOOK_SECRET_<ID> (e.g. PARTNER_WEBHOOK_SECRET_SETLE).
PARTNER_WEBHOOK_MASTER=change-me-to-a-long-random-string
# Seconds before a simulated partner answers (0 = immediately, used by the tests)
PARTNER_SIM_DELAY=4
